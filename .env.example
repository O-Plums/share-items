# Nom du produit (UI, manifest PWA, Open Graph). Optionnel — défaut "Sort your life".
# NEXT_PUBLIC_APP_NAME="Sort your life"
# NEXT_PUBLIC_APP_SHORT_NAME="Sort"

# URL publique du site (Open Graph, partages, sitemap, robots.txt).
# Défaut : https://www.sortyourlife.fr (doit correspondre au domaine canonique Vercel)
# NEXT_PUBLIC_SITE_URL="https://www.sortyourlife.fr"

# Vérification Google Search Console (balise meta google-site-verification)
# https://search.google.com/search-console → propriété → Méthode HTML
# Un token par défaut est déjà câblé dans src/lib/site.ts pour sortyourlife.fr.
# Override seulement si tu utilises un autre domaine.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Admin — emails autorisés sur /admin (séparés par des virgules)
ADMIN_EMAILS=""

# Légal — surfacé sur /legal/cgu et /legal/cgv (pas d'adresse postale au stade beta).
# Tant que ces variables ne sont pas définies, les pages affichent "[À compléter]".
# NEXT_PUBLIC_LEGAL_OWNER_NAME="Prénom Nom"
# NEXT_PUBLIC_LEGAL_EMAIL="contact@sortyourlife.fr"

# ─── Base de données (PostgreSQL obligatoire) ───
# Neon / Vercel Postgres / Supabase / Docker local

# Utilise l'URL « directe » / non poolée si les migrations échouent (Neon : Direct connection)
# Vercel Postgres : POSTGRES_PRISMA_URL ou l'URL fournie par Storage
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── Stockage images (production Vercel) ───
# Storage → Blob dans le dashboard Vercel → Create store
BLOB_READ_WRITE_TOKEN=""

# ─── Auth.js v5 (dashboard organisateur) ───
# Génère AUTH_SECRET avec : openssl rand -base64 32
AUTH_SECRET=""
# AUTH_URL n'est nécessaire que si Auth.js n'arrive pas à deviner l'URL (proxies, etc.)
# AUTH_URL="https://exemple.com"

# Google OAuth — https://console.cloud.google.com → API & Services → Credentials
# Redirect URI : {ORIGIN}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Sign in with Apple — https://developer.apple.com
# AUTH_APPLE_SECRET doit être un JWT (cf. `npx auth add apple` pour le générer)
# Redirect URI : {ORIGIN}/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
