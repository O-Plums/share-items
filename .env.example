# URL publique du site (Open Graph, partages WhatsApp, etc.)
# NEXT_PUBLIC_SITE_URL="https://share-items.vercel.app"

# Admin — emails autorisés sur /admin (séparés par des virgules)
ADMIN_EMAILS=""

# ─── Base de données (PostgreSQL obligatoire) ───
# Neon / Vercel Postgres / Supabase / Docker local

# Utilise l'URL « directe » / non poolée si les migrations échouent (Neon : Direct connection)
# Vercel Postgres : POSTGRES_PRISMA_URL ou l'URL fournie par Storage
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── Stockage images (production Vercel) ───
# Storage → Blob dans le dashboard Vercel → Create store
BLOB_READ_WRITE_TOKEN=""

# ─── Auth.js v5 (dashboard organisateur) ───
# Génère AUTH_SECRET avec : openssl rand -base64 32
AUTH_SECRET=""
# AUTH_URL n'est nécessaire que si Auth.js n'arrive pas à deviner l'URL (proxies, etc.)
# AUTH_URL="https://exemple.com"

# Google OAuth — https://console.cloud.google.com → API & Services → Credentials
# Redirect URI : {ORIGIN}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Sign in with Apple — https://developer.apple.com
# AUTH_APPLE_SECRET doit être un JWT (cf. `npx auth add apple` pour le générer)
# Redirect URI : {ORIGIN}/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
