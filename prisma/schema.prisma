// Share Items — PostgreSQL (Vercel Postgres, Neon, Supabase, Docker local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js (next-auth v5) ───
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  lists    List[]
  items    Item[]
  tags     UserTag[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Métier ───
// `creatorVisitorId` conservé pour migration v1 → v2 (claim post-login).
model List {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  // kind: "keep" | "donate" | "sell" | "custom"
  kind             String   @default("custom")
  userId           String?
  creatorVisitorId String?
  createdAt        DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Item[]

  @@index([userId])
  @@index([creatorVisitorId])
}

model Item {
  id        String   @id @default(cuid())
  // null = inventaire perso, pas encore assigné à une liste
  listId    String?
  userId    String?
  imageUrl  String
  label     String?
  room      String
  category  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  list  List?     @relation(fields: [listId], references: [id], onDelete: SetNull)
  user  User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes Vote[]
  match Match?
  tags  ItemTag[]

  @@index([listId, sortOrder])
  @@index([userId])
}

model UserTag {
  id        String   @id @default(cuid())
  userId    String
  label     String
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ItemTag[]

  @@unique([userId, label])
  @@index([userId])
}

model ItemTag {
  itemId    String
  userTagId String

  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userTag UserTag @relation(fields: [userTagId], references: [id], onDelete: Cascade)

  @@id([itemId, userTagId])
  @@index([userTagId])
}

// VoteValue: "YES" | "NO" — validé côté API
model Vote {
  id          String   @id @default(cuid())
  itemId      String
  visitorId   String
  displayName String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, visitorId])
  @@index([visitorId])
}

model Match {
  id          String   @id @default(cuid())
  itemId      String   @unique
  visitorId   String
  displayName String
  createdAt   DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([visitorId])
}
