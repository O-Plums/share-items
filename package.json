{
  "name": "sort-your-life",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 8080",
    "dev:pwa": "concurrently -p none \"serwist build --watch\" \"next dev -p 8080\"",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "build": "prisma generate && prisma migrate deploy && next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "vercel-build": "bash scripts/vercel-build.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@bprogress/next": "^3.2.12",
    "@formkit/auto-animate": "^0.9.0",
    "@prisma/client": "^5.22.0",
    "@serwist/next": "^9.5.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^0.27.0",
    "driver.js": "^1.4.0",
    "framer-motion": "^11.11.17",
    "nanoid": "^5.0.9",
    "next": "^15.0.3",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "serwist": "^9.5.11",
    "sharp": "^0.33.5",
    "use-pull-to-refresh": "^3.0.3"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.11",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
